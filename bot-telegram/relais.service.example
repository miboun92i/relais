[Unit]
Description=Relais Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relais
WorkingDirectory=/opt/relais
ExecStart=/opt/relais/.venv/bin/python -u /opt/relais/main.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/relais

[Install]
WantedBy=multi-user.target
