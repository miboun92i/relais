TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
IGNORE_CHAT_IDS=

# Fournisseur IA
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Panel
PANEL_ORIGINS=https://votre-panel.example.com,http://127.0.0.1:8765
HOST=127.0.0.1
PORT=8787

# Commercialisation / licences
# Générer un secret aléatoire d'au moins 32 caractères. Ne jamais le committer.
LICENSE_VERIFY_SECRET=
# Jeton de licence signé remis à cette installation.
LICENSE_TOKEN=
# 1 = licence liée à INSTALLATION_ID ; 0 = licence portable.
LICENSE_BIND_INSTALLATION=1
# Identifiant stable facultatif. Sur Railway, définir une valeur aléatoire une fois puis la conserver.
INSTALLATION_ID=
# Passer à 1 lorsque le contrôle de licence est branché au démarrage du service.
LICENSE_REQUIRED=0

# Créer le compte du panel avec : python configurer_compte.py
