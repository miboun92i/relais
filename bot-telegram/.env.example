TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
IGNORE_CHAT_IDS=

# Fournisseur IA
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Panel
PANEL_ORIGINS=https://votre-panel.example.com,http://127.0.0.1:8765
HOST=127.0.0.1
PORT=8787
# Utilisés uniquement si panel-account.json n'existe pas encore.
PANEL_BOOTSTRAP_USERNAME=
PANEL_BOOTSTRAP_PASSWORD=

# Commercialisation / licences
# La clé PRIVÉE reste uniquement chez le vendeur. Le client n'a que la clé publique.
LICENSE_PUBLIC_KEY=
LICENSE_TOKEN=
LICENSE_BIND_INSTALLATION=1
# Facultatif : sinon un identifiant stable est créé dans DATA_DIR.
INSTALLATION_ID=
LICENSE_REQUIRED=0

# Données persistantes (Railway volume recommandé)
DATA_DIR=/data
